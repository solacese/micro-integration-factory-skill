services:
  integration:
    build: .
    ports:
      - "127.0.0.1:${MI_HTTP_PORT:-18080}:8080"
    env_file: .env
    extra_hosts: ["host.docker.internal:host-gateway"]
    volumes:
      - ./config:/app/external/spring/config:ro
    read_only: true
    tmpfs: [/tmp]
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    mem_limit: 1g
    healthcheck:
      test: ["CMD", "java", "-cp", "/app/healthcheck.jar", "Healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 20
      start_period: 30s
  smoke:
    profiles: [tools]
    image: maven:3.9.15-eclipse-temurin-17
    working_dir: /workspace
    volumes: [".:/workspace"]
    env_file: .env
    extra_hosts: ["host.docker.internal:host-gateway"]
    environment:
      MI_SMOKE_BROKER: ${SOLACE_BROKER_URL:-tcp://host.docker.internal:55555}
    command: ["mvn", "-B", "verify"]
