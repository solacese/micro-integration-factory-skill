# For an existing broker, use its Docker-reachable SMF endpoint.
# On Docker Desktop, a host broker uses host.docker.internal rather than localhost.
SOLACE_BROKER_URL=tcp://host.docker.internal:55555
SOLACE_VPN=default
SOLACE_USERNAME=default
SOLACE_PASSWORD=replace-me
MI_HTTP_PORT=18080
SOLACE_INPUT_TOPIC=mi/{{ name }}/in
SOLACE_OUTPUT_TOPIC=mi/{{ name }}/out
SOLACE_QUEUE_GROUP={{ name }}
{% if webhook == 'stripe' %}
# Stripe Dashboard or `stripe listen` signing secret. Never enter it in the factory chat.
STRIPE_WEBHOOK_SECRET=replace-me
{% endif %}
