FROM maven:3.9.15-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.m2 mvn -q verify && printf '%s\n' \
    'import java.net.URI; import java.net.http.*; public class Healthcheck { public static void main(String[] a) throws Exception { var r=HttpClient.newHttpClient().send(HttpRequest.newBuilder(URI.create("http://localhost:8080/actuator/health")).timeout(java.time.Duration.ofSeconds(2)).build(), HttpResponse.BodyHandlers.ofString()); if(r.statusCode()!=200 || !r.body().contains("UP")) System.exit(1); }}' \
    > /tmp/Healthcheck.java && javac /tmp/Healthcheck.java && jar cf /tmp/healthcheck.jar -C /tmp Healthcheck.class

FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /workspace/target/mi.jar app.jar
COPY --from=build /tmp/healthcheck.jar healthcheck.jar
# External config overlay — mount runtime application.yml here
VOLUME /app/external/spring/config
EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.config.additional-location=optional:file:/app/external/spring/config/,optional:file:/app/external/spring/config/*/"]
