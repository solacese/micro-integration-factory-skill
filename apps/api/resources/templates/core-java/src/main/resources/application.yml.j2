server:
  port: 8080
spring:
  config:
    import: optional:file:./config/mi-config.yaml
  application:
    name: {{ name }}
  cloud:
    function:
      definition: ''
    stream:
      function:
        autodetect: false
      default-binder: solace
      bindings:
{% if webhook != 'stripe' %}
        process-in-0:
          destination: ${messaging.input-topic:${SOLACE_INPUT_TOPIC:mi/{{ name }}/in}}
          group: ${messaging.subscription:${SOLACE_QUEUE_GROUP:{{ name }}}}
          consumer:
            use-native-decoding: true
{% endif %}
        output-out-0:
          destination: ${messaging.output-topic:${SOLACE_OUTPUT_TOPIC:mi/{{ name }}/out}}
          producer:
            use-native-encoding: true
            error-channel-enabled: true

solace:
  java:
    host: ${broker.smf-url:${SOLACE_BROKER_URL:tcp://localhost:55555}}
    msgVpn: ${broker.vpn:${SOLACE_VPN:default}}
    clientUsername: ${broker.username:${SOLACE_USERNAME:default}}
    clientPassword: ${broker.password:${SOLACE_PASSWORD:default}}
mi:
  webhook-provider: ${webhook.provider:{{ webhook }}}
  stripe-webhook-secret: ${webhook.signing-secret:${STRIPE_WEBHOOK_SECRET:}}
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
