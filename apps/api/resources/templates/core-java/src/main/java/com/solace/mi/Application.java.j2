package com.solace.mi;

import java.util.*;
import java.util.function.Consumer;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.cloud.stream.function.StreamBridge;
import org.springframework.context.annotation.Bean;
import org.springframework.http.ResponseEntity;
import org.springframework.messaging.Message;
import org.springframework.messaging.support.MessageBuilder;
import org.springframework.web.bind.annotation.*;

/** Standard transport. Put business logic only in Core.java. */
@SpringBootApplication
public class Application {
    private static final Set<String> INTERNAL_HEADERS = Set.of("id", "timestamp", "mi_output_topics", "scst_targetdestination", "stripe-signature", "mi_correlation_id");
    public static void main(String[] args) { SpringApplication.run(Application.class, args); }

    @Bean Core core() { return new Core(); }

    @Bean Consumer<Message<byte[]>> process(Core core, StreamBridge bridge) {
        return message -> forward(core, bridge, message.getPayload(), message.getHeaders());
    }

    static String forward(Core core, StreamBridge bridge, byte[] payload, Map<String, ?> incoming) {
        if (payload.length > 1_048_576) throw new IllegalArgumentException("Payload exceeds 1 MiB");
        Map<String,Object> headers = new HashMap<>();
        incoming.forEach((key, value) -> {
            if (!INTERNAL_HEADERS.contains(key.toLowerCase(Locale.ROOT)) &&
                (value instanceof String || value instanceof Number || value instanceof Boolean || value instanceof byte[]))
                headers.put(key, value);
        });
        // Preserve test/application correlation on broker ingress, but never accept routing controls.
        headers.put("mi_correlation_id", incoming.getOrDefault("mi_correlation_id", null) instanceof String value ? value : UUID.randomUUID().toString());
        final byte[] result;
        try { result = core.process(payload, headers); }
        catch (IllegalArgumentException rejected) { throw rejected; }
        catch (Exception error) { throw new IllegalStateException("Core processing failed", error); }
        if (result == null) throw new IllegalStateException("Core.java returned no result");
        Object routing = headers.remove("mi_output_topics");
        headers.remove("scst_targetDestination");
        List<String> topics = outputTopics(routing);
        if (topics.isEmpty()) {
            publish(bridge, result, headers, null);
        } else {
            for (String topic : topics) publish(bridge, result, headers, topic);
        }
        return String.valueOf(headers.get("mi_correlation_id"));
    }

    static List<String> outputTopics(Object value) {
        if (value == null) return List.of();
        if (!(value instanceof List<?> values) || values.isEmpty() || values.size() > 16)
            throw new IllegalArgumentException("Core routing needs one to sixteen concrete topics");
        Set<String> topics = new LinkedHashSet<>();
        for (Object candidate : values) {
            if (!(candidate instanceof String topic) || topic.length() > 250 ||
                !topic.matches("[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*"))
                throw new IllegalArgumentException("Core routing contains an invalid concrete topic");
            topics.add(topic);
        }
        return List.copyOf(topics);
    }

    private static void publish(StreamBridge bridge, byte[] payload, Map<String,Object> headers, String topic) {
        var message = MessageBuilder.withPayload(payload).copyHeaders(headers);
        if (topic != null) message.setHeader("scst_targetDestination", topic);
        if (!bridge.send("output-out-0", message.build()))
            throw new IllegalStateException("Output publisher did not accept the message");
    }

    static void verifyStripe(byte[] payload, String signature, String secret, long now) {
        if (secret == null || secret.isBlank() || secret.equals("replace-me"))
            throw new IllegalStateException("Configure STRIPE_WEBHOOK_SECRET");
        if (signature == null || signature.length() > 4096)
            throw new IllegalArgumentException("Missing Stripe signature");
        String timestamp = null;
        List<String> candidates = new ArrayList<>();
        for (String item : signature.split(",")) {
            String[] pair = item.trim().split("=", 2);
            if (pair.length != 2) continue;
            if (pair[0].equals("t")) {
                if (timestamp != null) throw new IllegalArgumentException("Ambiguous signature timestamp");
                timestamp = pair[1];
            } else if (pair[0].equals("v1")) candidates.add(pair[1]);
        }
        try {
            if (timestamp == null || !timestamp.matches("[0-9]{1,12}")) throw new IllegalArgumentException("Invalid signature timestamp");
            long signedAt = Long.parseLong(timestamp);
            if (signedAt < now - 300 || signedAt > now + 300) throw new IllegalArgumentException("Expired signature timestamp");
            Mac mac = Mac.getInstance("HmacSHA256");
            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
            mac.update((timestamp + ".").getBytes(StandardCharsets.UTF_8));
            byte[] expected = mac.doFinal(payload);
            for (String candidate : candidates) {
                if (candidate.matches("[a-fA-F0-9]{64}") && MessageDigest.isEqual(expected, HexFormat.of().parseHex(candidate))) return;
            }
        } catch (java.security.GeneralSecurityException error) {
            throw new IllegalStateException("Signature verification unavailable", error);
        }
        throw new IllegalArgumentException("Invalid Stripe signature");
    }

    @RestController
    static class Ingress {
        private final Core core;
        private final StreamBridge bridge;
        private final String webhookProvider;
        private final String stripeSecret;
        Ingress(Core core, StreamBridge bridge, @Value("${mi.webhook-provider:none}") String webhookProvider,
                @Value("${mi.stripe-webhook-secret:}") String stripeSecret) {
            this.core = core; this.bridge = bridge; this.webhookProvider = webhookProvider; this.stripeSecret = stripeSecret;
        }

        @PostMapping("/ingest")
        ResponseEntity<Map<String,String>> ingest(@RequestBody byte[] payload, @RequestHeader Map<String,String> headers) {
            if (payload.length > 1_048_576) throw new IllegalArgumentException("Payload exceeds 1 MiB");
            if (webhookProvider.equals("stripe")) {
                String signature = headers.entrySet().stream().filter(e -> e.getKey().equalsIgnoreCase("Stripe-Signature"))
                    .map(Map.Entry::getValue).findFirst().orElse(null);
                verifyStripe(payload, signature, stripeSecret, java.time.Instant.now().getEpochSecond());
            }
            return ResponseEntity.accepted().body(Map.of("status", "accepted",
                "correlationId", forward(core, bridge, payload, headers)));
        }

        @ExceptionHandler(IllegalArgumentException.class)
        ResponseEntity<Map<String,String>> rejected() {
            return ResponseEntity.unprocessableEntity().body(Map.of("status", "rejected", "reason", "Payload or webhook signature rejected"));
        }

        @ExceptionHandler(IllegalStateException.class)
        ResponseEntity<Map<String,String>> failed() {
            return ResponseEntity.status(503).body(Map.of("status", "processing_failed"));
        }
    }
}
