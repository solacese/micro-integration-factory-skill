package com.solace.mi;

import java.util.*;
import java.util.concurrent.*;
import java.nio.charset.StandardCharsets;
import java.net.URI;
import java.net.http.*;
import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;
import com.solacesystems.jcsmp.*;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable;
import tools.jackson.databind.json.JsonMapper;
import org.springframework.boot.env.YamlPropertySourceLoader;
import org.springframework.core.io.FileSystemResource;
import static org.junit.jupiter.api.Assertions.*;

@EnabledIfEnvironmentVariable(named="MI_SMOKE_BROKER", matches=".+")
class BrokerRoundTripIT {
    private static String config(String key, String fallback) throws Exception {
        var path=System.getenv().getOrDefault("MI_TEST_CONFIG","config/mi-config.yaml");
        var resource=new FileSystemResource(path);
        if(!resource.exists()) return fallback;
        for(var source:new YamlPropertySourceLoader().load("shared-mi",resource)) {
            var value=source.getProperty(key);
            if(value!=null) return value.toString();
        }
        return fallback;
    }
    @Test void inputTraversesRunningMiAndReturnsOnEveryExpectedTopic() throws Exception {
        var examples=JsonMapper.builder().build().readTree(getClass().getResourceAsStream("/core-examples.json"));
        var example=examples.valueStream().filter(e -> e.has("output_base64")).findFirst().orElseThrow();
        List<String> topics=new ArrayList<>();
        if(example.has("output_topics")) example.get("output_topics").forEach(t -> topics.add(t.asText()));
        else topics.add(config("messaging.output-topic","mi/{{ name }}/out"));
        var p=new JCSMPProperties();
        p.setProperty(JCSMPProperties.HOST,config("broker.smf-url","tcp://localhost:55555"));
        p.setProperty(JCSMPProperties.VPN_NAME,config("broker.vpn","default"));
        p.setProperty(JCSMPProperties.USERNAME,config("broker.username","default"));
        p.setProperty(JCSMPProperties.PASSWORD,config("broker.password","default"));
        var session=JCSMPFactory.onlyInstance().createSession(p);
        var received=new ConcurrentHashMap<String,byte[]>();
        var latch=new CountDownLatch(topics.size());
        String trace=UUID.randomUUID().toString();
        try {
            session.connect();
            var consumer=session.getMessageConsumer(new XMLMessageListener() {
                public void onReceive(BytesXMLMessage m) {
                    try {
                        if(m.getProperties()!=null && trace.equals(m.getProperties().getString("mi_correlation_id"))) {
                            byte[] bytes;
                            if(m instanceof TextMessage t) bytes=t.getText().getBytes(StandardCharsets.UTF_8);
                            else if(m.hasAttachment()) { var b=m.getAttachmentByteBuffer(); bytes=new byte[b.remaining()]; b.get(bytes); }
                            else bytes=m.getBytes();
                            if(received.putIfAbsent(m.getDestination().getName(),bytes)==null) latch.countDown();
                        }
                    } catch(Exception error) { throw new RuntimeException(error); }
                }
                public void onException(JCSMPException error) { throw new RuntimeException(error); }
            });
            for(String topic:topics) session.addSubscription(JCSMPFactory.onlyInstance().createTopic(topic),true);
            consumer.start();
            byte[] input=Base64.getDecoder().decode(example.get("input_base64").asText());
{% if webhook == 'stripe' %}
            var client=HttpClient.newBuilder().connectTimeout(java.time.Duration.ofSeconds(5)).build();
            String url=System.getenv().getOrDefault("MI_SMOKE_HTTP","http://localhost:18080/ingest");
            // The real HTTP endpoint must reject unsigned events before publishing anything.
            var unsigned=client.send(HttpRequest.newBuilder(URI.create(url)).timeout(java.time.Duration.ofSeconds(10))
                .header("Content-Type","application/json").POST(HttpRequest.BodyPublishers.ofByteArray(input)).build(),HttpResponse.BodyHandlers.ofString());
            assertEquals(422,unsigned.statusCode(),"Unsigned webhook was not rejected");
            String timestamp=Long.toString(java.time.Instant.now().getEpochSecond());
            String secret=config("webhook.signing-secret",System.getenv("STRIPE_WEBHOOK_SECRET"));
            assertNotNull(secret,"Configure STRIPE_WEBHOOK_SECRET in .env");
            Mac mac=Mac.getInstance("HmacSHA256");
            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8),"HmacSHA256"));
            mac.update((timestamp+".").getBytes(StandardCharsets.UTF_8));
            String signature="t="+timestamp+",v1="+HexFormat.of().formatHex(mac.doFinal(input));
            var request=HttpRequest.newBuilder(URI.create(url)).timeout(java.time.Duration.ofSeconds(15))
                .header("Content-Type","application/json").header("Stripe-Signature",signature).header("mi_correlation_id",trace)
                .POST(HttpRequest.BodyPublishers.ofByteArray(input)).build();
            var response=client.send(request,HttpResponse.BodyHandlers.ofString());
            assertEquals(202,response.statusCode(),"Signed webhook failed: "+response.body());
{% else %}
            var producer=session.getMessageProducer(new JCSMPStreamingPublishEventHandler() {
                public void responseReceived(String id) {}
                public void handleError(String id,JCSMPException error,long timestamp) { throw new RuntimeException(error); }
            });
            var message=JCSMPFactory.onlyInstance().createMessage(BytesMessage.class);
            message.writeBytes(input);
            message.setDeliveryMode(DeliveryMode.PERSISTENT);
            var headers=JCSMPFactory.onlyInstance().createMap();
            if(example.has("headers")) for(var e:example.get("headers").properties()) headers.putString(e.getKey(),e.getValue().asText());
            headers.putString("mi_correlation_id",trace);
            message.setProperties(headers);
            producer.send(message,JCSMPFactory.onlyInstance().createTopic(config("messaging.input-topic","mi/{{ name }}/in")));
{% endif %}
            assertTrue(latch.await(30,TimeUnit.SECONDS),"Missing correlated results on topics: "+topics+"; received: "+received.keySet());
            for(String topic:topics) assertArrayEquals(Base64.getDecoder().decode(example.get("output_base64").asText()),received.get(topic),topic);
        } finally { session.closeSession(); }
    }
}
