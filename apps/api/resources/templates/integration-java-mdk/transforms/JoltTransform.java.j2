package com.spec2event.generated.transform;

import com.bazaarvoice.jolt.Chainr;
import com.bazaarvoice.jolt.JsonUtils;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.springframework.core.io.ClassPathResource;
import org.springframework.stereotype.Component;

import jakarta.annotation.PostConstruct;
import java.io.InputStream;
import java.util.List;
import java.util.function.Function;

/**
 * JOLT transform for the {{ title }} micro-integration.
 *
 * Applies a JOLT transformation spec (loaded from classpath) to each
 * message payload. JOLT is a JSON-to-JSON transformation library.
 */
@Component("messageTransform")
public class JoltTransform implements Function<JsonNode, JsonNode> {

    private final ObjectMapper objectMapper = new ObjectMapper();
    private Chainr chainr;

    @PostConstruct
    public void init() throws Exception {
        try (InputStream is = new ClassPathResource("transforms/jolt-spec.json").getInputStream()) {
            List<Object> spec = JsonUtils.jsonToList(new String(is.readAllBytes()));
            this.chainr = Chainr.fromSpec(spec);
        }
    }

    @Override
    public JsonNode apply(JsonNode input) {
        Object inputObj = objectMapper.convertValue(input, Object.class);
        Object transformed = chainr.transform(inputObj);
        return objectMapper.valueToTree(transformed);
    }
}
