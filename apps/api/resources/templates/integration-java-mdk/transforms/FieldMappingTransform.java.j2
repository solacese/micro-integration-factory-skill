package com.spec2event.generated.transform;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import org.springframework.stereotype.Component;

import java.util.function.Function;

/**
 * Field mapping transform for the {{ title }} micro-integration.
 *
 * Performs declarative field renaming, selection, and flattening
 * based on the configured mapping rules.
 */
@Component("messageTransform")
public class FieldMappingTransform implements Function<JsonNode, JsonNode> {

    private final ObjectMapper objectMapper = new ObjectMapper();

    @Override
    public JsonNode apply(JsonNode input) {
        ObjectNode output = objectMapper.createObjectNode();

        // TODO: Apply field mappings from configuration
        // Each mapping: { "source": "source.field.path", "target": "targetFieldName" }
{% if field_mappings is defined and field_mappings %}
{% for mapping in field_mappings %}
        mapField(input, output, "{{ mapping.source }}", "{{ mapping.target }}");
{% endfor %}
{% else %}
        // No mappings configured; copy all fields
        input.fields().forEachRemaining(entry -> output.set(entry.getKey(), entry.getValue()));
{% endif %}

        return output;
    }

    private void mapField(JsonNode input, ObjectNode output, String sourcePath, String targetName) {
        JsonNode value = resolve(input, sourcePath);
        if (value != null && !value.isMissingNode()) {
            output.set(targetName, value);
        }
    }

    private JsonNode resolve(JsonNode node, String path) {
        String[] segments = path.split("\\.");
        JsonNode current = node;
        for (String segment : segments) {
            if (current == null || current.isMissingNode()) {
                return null;
            }
            current = current.get(segment);
        }
        return current;
    }
}
