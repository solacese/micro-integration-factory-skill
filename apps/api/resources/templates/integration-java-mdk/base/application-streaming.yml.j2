# --------------------------
# STREAMING CONFIGURATION
# Generated by Agentic Integration Factory
# Provides enterprise streaming defaults:
#   - DLQ + retry + exponential backoff + parking-lot
#   - Consumer groups and partitioning
#   - Schema registry wiring
#   - Metrics and observability
# --------------------------

spring:
  cloud:
    stream:
      # -- Error handling and DLQ --
      default:
        consumer:
          max-attempts: {{ streaming.retry_max_attempts | default(3) }}
          back-off-initial-interval: {{ streaming.backoff_initial_ms | default(1000) }}
          back-off-max-interval: {{ streaming.backoff_max_ms | default(30000) }}
          back-off-multiplier: {{ streaming.backoff_multiplier | default(2.0) }}
{% if streaming.dlq_enabled | default(true) %}
          # DLQ destination for messages that exhaust retries
          default-retryable: true
{% endif %}

      bindings:
{% for workflow in workflows %}
        input-{{ workflow.index }}:
          consumer:
            concurrency: {{ streaming.consumer_concurrency | default(1) }}
{% if streaming.consumer_group is defined %}
            group: {{ streaming.consumer_group }}
{% endif %}
{% if streaming.dlq_enabled | default(true) %}
        # DLQ binding for workflow {{ workflow.index }}
        input-{{ workflow.index }}-dlq:
          destination: {{ workflow.input_destination }}/dlq
          binder: solace
{% endif %}
{% endfor %}

{% if streaming.schema_registry_enabled | default(false) %}
      # -- Schema Registry --
      schema-registry-client:
        endpoint: ${SCHEMA_REGISTRY_URL:http://localhost:8081}
      schema:
        avro:
          schema-locations: classpath:avro/*.avsc
{% endif %}

      solace:
        default:
          consumer:
{% if streaming.partitioning_enabled | default(false) %}
            # Partitioning for ordered processing
            partitioned: true
            partition-key-expression: "headers['partitionKey']"
{% endif %}
          producer:
{% if streaming.partitioning_enabled | default(false) %}
            partitioned: true
            partition-key-expression: "headers['partitionKey']"
            partition-count: {{ streaming.partition_count | default(4) }}
{% endif %}

# -- Idempotency --
idempotency:
  enabled: {{ streaming.idempotency_enabled | default(true) | lower }}
  store: ${IDEMPOTENCY_STORE:in-memory}
  ttl-seconds: {{ streaming.idempotency_ttl_seconds | default(86400) }}

# -- Parking lot (messages that fail DLQ max retries) --
parking-lot:
  enabled: {{ streaming.parking_lot_enabled | default(true) | lower }}
  max-dlq-attempts: {{ streaming.parking_lot_max_attempts | default(3) }}
  destination-suffix: /parking-lot

# -- Metrics and Observability --
management:
  metrics:
    export:
      enabled: true
    tags:
      service: {{ service_name }}
      version: {{ service_version }}
  endpoint:
    metrics:
      enabled: true
    prometheus:
      enabled: true

# -- Custom streaming metrics --
streaming:
  metrics:
    lag:
      enabled: true
    throughput:
      enabled: true
      window-seconds: 60
    failure-rate:
      enabled: true
      window-seconds: 300
