package com.spec2event.generated.service;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpEntity;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpMethod;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

/**
 * REST target sink for the {{ title }} micro-integration.
 *
 * Delivers events from Solace to an external REST/webhook endpoint.
 * Supports idempotent delivery via correlationId header and retry
 * with exponential backoff configured via Spring Retry.
 *
 * Direction: Solace -> REST/Webhook (target/egress)
 */
@Service
public class RestTargetSinkService {

    private static final Logger log = LoggerFactory.getLogger(RestTargetSinkService.class);

    private final RestTemplate restTemplate;
    private final ObjectMapper objectMapper;

    @Value("${target.rest.url:http://localhost:8081/webhook}")
    private String targetUrl;

    @Value("${target.rest.method:POST}")
    private String httpMethod;

    public RestTargetSinkService(ObjectMapper objectMapper) {
        this.restTemplate = new RestTemplate();
        this.objectMapper = objectMapper;
    }

    /**
     * Deliver an event payload to the configured REST endpoint.
     *
     * @param payload       The event payload (JSON)
     * @param eventName     The canonical event name
     * @param correlationId Unique correlation ID for tracing and idempotency
     */
    public void deliver(JsonNode payload, String eventName, String correlationId) {
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.set("X-Correlation-Id", correlationId);
        headers.set("X-Event-Name", eventName);
        headers.set("X-Idempotency-Key", correlationId);

        String body;
        try {
            body = objectMapper.writeValueAsString(payload);
        } catch (Exception e) {
            log.error("Failed to serialize payload for correlationId={}", correlationId, e);
            throw new RuntimeException("Payload serialization failed", e);
        }

        HttpEntity<String> request = new HttpEntity<>(body, headers);

        log.debug("Delivering event={} to {} correlationId={}", eventName, targetUrl, correlationId);

        ResponseEntity<String> response = restTemplate.exchange(
                targetUrl,
                HttpMethod.valueOf(httpMethod.toUpperCase()),
                request,
                String.class
        );

        if (response.getStatusCode().is2xxSuccessful()) {
            log.info("Successfully delivered event={} correlationId={} status={}",
                    eventName, correlationId, response.getStatusCode().value());
        } else {
            log.warn("Target returned non-2xx status={} for correlationId={}",
                    response.getStatusCode().value(), correlationId);
            throw new RuntimeException("Target returned " + response.getStatusCode());
        }
    }
}
