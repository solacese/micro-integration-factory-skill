# Agentic Integration Factory
# Prepared demo env for running the Stripe and PostgreSQL prepared paths from one factory.
# This file is intentionally sanitized. The activation script preserves non-empty
# secret and infrastructure values from the current root `.env`.

# Core platform
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://spec2event:spec2event@localhost:5432/spec2event
REDIS_URL=redis://localhost:6379/0
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DEMO_ADMIN_PASSWORD=replace-me
ALLOW_INSECURE_LOCAL_LOGIN=false
WORKSPACE_ROOT=__REPO_ROOT__/workspace
RUNS_ROOT=__REPO_ROOT__/generated-runs
MDK_SAMPLE_ROOT=__REPO_ROOT__/mdk-reference/micro-integration
ENABLE_RQ=false
LOG_LEVEL=INFO

# Main execution mode
SOURCE_MODE=multi
SOURCE_MULTI_MODES=openapi,database
SOURCE_ADAPTER_MODE=auto
DEPLOYMENT_TARGET=ec2
EVENT_TRANSPORT=solace
GOVERNANCE_TARGET=event_portal

# AWS and runtime deployment
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
ECR_REPOSITORY_NAME=agentic-integration-factory-generated-integrations
CONTROL_PLANE_SECURITY_GROUP_ID=
CONTROL_PLANE_SUBNET_ID=
CONTROL_PLANE_VPC_ID=
EPHEMERAL_EC2_TTL_MINUTES=60
PUBLIC_BASE_URL=

# Optional direct EC2 target
DEPLOY_EC2_HOST=
DEPLOY_EC2_SSH_USER=ec2-user
DEPLOY_EC2_SSH_PRIVATE_KEY=
DEPLOY_EC2_PORT=22

# Container registry
CONTAINER_REGISTRY=
CONTAINER_REGISTRY_USERNAME=
CONTAINER_REGISTRY_PASSWORD=
CONTAINER_IMAGE_PREFIX=ghcr.io/example/spec2event

# Solace PubSub+ runtime transport
SOLACE_BROKER_URL=
SOLACE_VPN=
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_WEB_MESSAGING_URL=

# Solace Event Portal
EVENT_PORTAL_BASE_URL=
EVENT_PORTAL_TOKEN=
EVENT_PORTAL_ORG_ID=
EVENT_PORTAL_DOMAIN_ID=
EVENT_PORTAL_RUNTIME_REGION=

# AI refinement endpoint
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# OpenAPI source
SOURCE_OPENAPI_FILE=__REPO_ROOT__/samples/openapi/stripe-webhook-demo.yaml
SOURCE_OPENAPI_URL=
SOURCE_API_BASE_URL=
SOURCE_API_KEY=
SOURCE_API_AUTH_TYPE=
SOURCE_GRAPHQL_URL=
SOURCE_GRPC_ENDPOINT=
SOURCE_WEBHOOK_PUBLIC_URL=
SOURCE_WEBHOOK_SIGNATURE_HEADER=Stripe-Signature
SOURCE_SAAS_VENDOR=stripe

# Database source
SOURCE_DATABASE_URL=
SOURCE_DATABASE_KIND=postgres
SOURCE_DATABASE_HOST=
SOURCE_DATABASE_PORT=5432
SOURCE_DATABASE_NAME=
SOURCE_DATABASE_SCHEMA=public
SOURCE_DATABASE_USERNAME=
SOURCE_DATABASE_PASSWORD=
SOURCE_DATABASE_SSLMODE=require

# Optional Stripe credentials for later live verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
