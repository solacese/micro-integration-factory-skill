import org.junit.jupiter.api.Test;

import static org.assertj.core.api.Assertions.assertThat;

class CanonicalEventServiceTest {

    @Test
    void planForRecordReturnsObservedAndCreatedForFirstSeenRow() {
        CanonicalEventService service = new CanonicalEventService();
        ObjectMapper objectMapper = new ObjectMapper();
        ObjectNode current = objectMapper.createObjectNode();
{% for column in database_columns %}
{% if column.name == database_config.idColumn %}
        current.put("{{ column.name }}", 101);
{% elif column.name == "price" %}
        current.put("{{ column.name }}", 49.99);
{% elif column.name == "stock_quantity" %}
        current.put("{{ column.name }}", 10);
{% elif "timestamp" in column.dataType %}
        current.put("{{ column.name }}", "2026-03-23T10:00:00Z");
{% else %}
        current.put("{{ column.name }}", "{{ column.name }}-value");
{% endif %}
{% endfor %}

        assertThat(service.planForRecord(current, null))
                .extracting(CanonicalEventService.EventBlueprint::eventName)
                .contains("{{ event_bindings[0].eventName }}", "{{ event_bindings[1].eventName }}");
    }

