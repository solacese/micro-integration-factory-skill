package com.spec2event.generated;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.spec2event.generated.service.CanonicalEventService;
import org.junit.jupiter.api.Test;

import static org.assertj.core.api.Assertions.assertThat;

class CanonicalEventServiceTest {

    private final CanonicalEventService service = new CanonicalEventService();
    private final ObjectMapper objectMapper = new ObjectMapper();

    @Test
    void plansEventsForGeneratedOperation() {
        ObjectNode payload = objectMapper.createObjectNode();
        payload.put("demo", "value");
        assertThat(service.planForOperation("{{ operations[0].operationId }}", payload)).isNotNull();
    }

{% for operation in operations if operation.stripeWebhook %}
    @Test
    void mapsStripeWebhookTypesToDedicatedBlueprints() {
        ObjectNode payload = objectMapper.createObjectNode();
        payload.put("type", "{{ operation.eventCandidates[0].matchStrategy.stripeType }}");

        CanonicalEventService.EventBlueprint blueprint = service
                .planForOperation("{{ operation.operationId }}", payload)
                .get(0);

        assertThat(blueprint.eventName()).isEqualTo("{{ operation.eventCandidates[0].canonicalEventName }}");
        assertThat(blueprint.schemaName()).isEqualTo("{{ operation.eventCandidates[0].schemaName }}");
        assertThat(blueprint.schemaSubject()).contains("{{ operation.eventCandidates[0].schemaName }}");
        assertThat(blueprint.serializerFamily()).isEqualTo("{{ operation.eventCandidates[0].serializerFamily }}");
        assertThat(blueprint.deserializerFamily()).isEqualTo("{{ operation.eventCandidates[0].deserializerFamily }}");
    }
{% endfor %}
}
