package com.spec2event.generated.service;

import com.fasterxml.jackson.databind.JsonNode;
import org.springframework.stereotype.Service;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

@Service
public class CanonicalEventService {

    public record EventBlueprint(
            String bindingName,
            String topicName,
            String eventName,
            String schemaName,
            String applicationName,
            String sourceSystem,
            String contentType,
            String schemaFormat,
            String serializerFamily,
            String deserializerFamily,
            String schemaSubject,
            String schemaVersion,
            String compatibilityMode
    ) {}

    private static final Map<String, List<EventBlueprint>> OPERATION_EVENTS = new LinkedHashMap<>();
    private static final Map<String, List<EventBlueprint>> STRIPE_EVENT_TYPES = new LinkedHashMap<>();

    static {
{% for operation in operations if operation.eventCandidates and operation.renderInGeneratedController %}
        OPERATION_EVENTS.put("{{ operation.operationId }}", List.of(
{% for event in operation.eventCandidates %}
                new EventBlueprint(
                        "{{ event.bindingName }}",
                        "{{ event.topicName }}",
                        "{{ event.canonicalEventName }}",
                        "{{ event.schemaName }}",
                        "{{ event.applicationName }}",
                        "{{ event.sourceSystem }}",
                        "{{ event.contentType }}",
                        "{{ event.schemaFormat }}",
                        "{{ event.serializerFamily }}",
                        "{{ event.deserializerFamily }}",
                        "{{ event.schemaSubject }}",
                        "{{ event.schemaVersion }}",
                        "{{ event.compatibilityMode }}"
                ){% if not loop.last %},{% endif %}
{% endfor %}
        ));
{% endfor %}
{% for operation in operations if operation.stripeWebhook %}
{% for event in operation.eventCandidates %}
        STRIPE_EVENT_TYPES.put("{{ event.matchStrategy.stripeType }}", List.of(
                new EventBlueprint(
                        "{{ event.bindingName }}",
                        "{{ event.topicName }}",
                        "{{ event.canonicalEventName }}",
                        "{{ event.schemaName }}",
                        "{{ event.applicationName }}",
                        "{{ event.sourceSystem }}",
                        "{{ event.contentType }}",
                        "{{ event.schemaFormat }}",
                        "{{ event.serializerFamily }}",
                        "{{ event.deserializerFamily }}",
                        "{{ event.schemaSubject }}",
                        "{{ event.schemaVersion }}",
                        "{{ event.compatibilityMode }}"
                )
        ));
{% endfor %}
{% endfor %}
    }

    public List<EventBlueprint> planForOperation(String operationId, JsonNode payload) {
{% for operation in operations if operation.stripeWebhook %}
        if ("{{ operation.operationId }}".equals(operationId)) {
            return planStripeEvents(payload);
        }
{% endfor %}
        return OPERATION_EVENTS.getOrDefault(operationId, List.of());
    }

    private List<EventBlueprint> planStripeEvents(JsonNode payload) {
        String stripeType = payload != null && payload.hasNonNull("type") ? payload.get("type").asText() : "";
        return STRIPE_EVENT_TYPES.getOrDefault(stripeType, List.of());
    }
}
